{
  "expo": {
    "name": "Sync",
    "slug": "syncapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "syncapp",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#151816"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.feridun.syncapp",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#151816"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.syncapp.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "syncapp"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sync lets you choose a profile photo and select audio or video from your library for routine music.",
          "cameraPermission": "Sync uses the camera only when you choose to take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Sync lets you choose a profile photo and select audio or video from your library for routine music.",
          "savePhotosPermission": false,
          "granularPermissions": ["audio"]
        }
      ],
      ["expo-av", { "microphonePermission": false }],
      "expo-video",
      ["expo-secure-store", { "faceIDPermission": false }]
    ],
    "extra": {
      "eas": {
        "projectId": "2b38178c-60e8-4fe2-94da-f51dc14f4efc"
      }
    },
    "owner": "feridunalacam"
  }
}
