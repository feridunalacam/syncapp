# Public mobile configuration. Copy to .env.local (ignored by Git).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Social sign-in checks the live Supabase provider settings when selected.
# Configure Google/Apple in Supabase; client secrets never belong in this file.

# RevenueCat PUBLIC SDK keys: appl_ for iOS, goog_ for Android.
# test_ keys work only in debug development; never put secret API keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# iOS preview/production require a distinct App Store public key from the review RC project.
# Optional for development; Test Store/private keys and reuse of the production-project key are invalid.
EXPO_PUBLIC_REVENUECAT_REVIEW_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=sync_pro

# EAS sets this explicitly per profile. Local development uses a debug build.
EXPO_PUBLIC_BUILD_PROFILE=development

# Spotify stays development-only until public quota and commercial approval.
EXPO_PUBLIC_SPOTIFY_ENABLED=true

# Native Apple Music timed playback is owner-development-only pending permissions.
# Enable explicitly only with __DEV__ and build profile development; release/preview stay off.
EXPO_PUBLIC_APPLE_MUSIC_ENABLED=false

# Standard user-controlled Apple Music player; independent from interval playback.
# EAS enables it only in the selected iOS profiles. No Sync account or Pro required.
EXPO_PUBLIC_APPLE_MUSIC_COMPANION_ENABLED=false

# Generic WebView media extraction / URL import is owner-development-only.
# Files imports and ordinary external sound-library links remain available.
EXPO_PUBLIC_WEB_MEDIA_IMPORT_ENABLED=false

# Public HTTPS pages are required before checkout is enabled.
EXPO_PUBLIC_PRIVACY_URL=https://sync-app-support.feridun.chatgpt.site/privacy
EXPO_PUBLIC_TERMS_URL=https://sync-app-support.feridun.chatgpt.site/terms

# AdMob public IDs. Development uses Google demo ad units; release stays off until verified.
EXPO_PUBLIC_ADS_ENABLED=false
# Explicit demo ad inventory is allowed in preview, never production.
EXPO_PUBLIC_ADS_TEST_MODE=false
ADMOB_IOS_APP_ID=ca-app-pub-6450876479080332~3587231996
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-6450876479080332/9078718471
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-6450876479080332/7535195808
ADMOB_ANDROID_APP_ID=ca-app-pub-6450876479080332~6260983443
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-6450876479080332/8476083240
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-6450876479080332/8560357078
