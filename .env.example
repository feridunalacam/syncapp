# Public mobile configuration. Copy to .env.local (ignored by Git).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Enable only after configuring these providers in Supabase.
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false

# RevenueCat PUBLIC app SDK keys; never put secret API keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=sync_pro

# Public HTTPS pages are required before checkout is enabled.
EXPO_PUBLIC_PRIVACY_URL=https://sync-app-support.feridun.chatgpt.site/privacy
EXPO_PUBLIC_TERMS_URL=https://sync-app-support.feridun.chatgpt.site/terms
